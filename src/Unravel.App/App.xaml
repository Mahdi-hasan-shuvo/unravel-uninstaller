<Application x:Class="Unravel.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Unravel.App.Infrastructure"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Index 0 is the colour palette; ThemeManager swaps it at runtime. -->
                <ResourceDictionary Source="Themes/Light.xaml"/>
                <ResourceDictionary Source="Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <infra:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
            <infra:NullToCollapsedConverter x:Key="NullToCollapsed"/>
            <infra:BytesConverter x:Key="Bytes"/>
            <infra:DateConverter x:Key="Date"/>
            <infra:LeftoverWeightConverter x:Key="LeftoverWeight"/>
            <infra:LeftoverBrushConverter x:Key="LeftoverBrush"/>
            <infra:LeftoverGlyphConverter x:Key="LeftoverGlyph"/>
            <infra:ConfidenceBrushConverter x:Key="ConfidenceBrush"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
