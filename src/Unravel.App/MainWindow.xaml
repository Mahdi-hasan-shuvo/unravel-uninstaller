<Window x:Class="Unravel.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unravel" Width="1280" Height="820" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen" Icon="unravel.ico"
        Background="{DynamicResource WindowBrush}" FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{DynamicResource TextBrush}" TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavColumn" Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation -->
        <Border Background="{DynamicResource NavBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel x:Name="NavPanel" Margin="12,16,12,12">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,18">
                    <Image Source="unravel.png" Width="30" Height="30"/>
                    <StackPanel x:Name="BrandText" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Unravel" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Uninstaller &amp; clean-up" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="NavFooter" DockPanel.Dock="Bottom">
                    <Button x:Name="HunterButton" AutomationProperties.Name="Hunter mode" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Click="Hunter_Click"
                            ToolTip="Hide this window and show a target you can drag onto any window or desktop icon">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE81D;" Margin="0,0,12,0" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="Hunter mode"/>
                        </StackPanel>
                    </Button>
                    <RadioButton AutomationProperties.Name="Activity &amp; recovery" Style="{StaticResource NavItem}" GroupName="Nav" Tag="recovery" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE777;" Margin="0,0,12,0"/><TextBlock Text="Activity &amp; recovery"/></StackPanel>
                    </RadioButton>
                    <RadioButton AutomationProperties.Name="Settings" x:Name="NavSettings" Style="{StaticResource NavItem}" GroupName="Nav" Tag="settings" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE713;" Margin="0,0,12,0"/><TextBlock Text="Settings"/></StackPanel>
                    </RadioButton>
                    <RadioButton AutomationProperties.Name="About &amp; help" Style="{StaticResource NavItem}" GroupName="Nav" Tag="about" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Margin="0,0,12,0"/><TextBlock Text="About &amp; help"/></StackPanel>
                    </RadioButton>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="NavList">
                        <TextBlock Text="APPS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource FaintTextBrush}" Margin="10,0,0,6"/>
                        <RadioButton AutomationProperties.Name="Programs" x:Name="NavPrograms" Style="{StaticResource NavItem}" GroupName="Nav" Tag="programs" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE71D;" Margin="0,0,12,0"/><TextBlock Text="Programs"/></StackPanel>
                        </RadioButton>
                        <RadioButton AutomationProperties.Name="Windows apps" Style="{StaticResource NavItem}" GroupName="Nav" Tag="apps" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE719;" Margin="0,0,12,0"/><TextBlock Text="Windows apps"/></StackPanel>
                        </RadioButton>
                        <RadioButton AutomationProperties.Name="Startup manager" Style="{StaticResource NavItem}" GroupName="Nav" Tag="startup" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE7E8;" Margin="0,0,12,0"/><TextBlock Text="Startup manager"/></StackPanel>
                        </RadioButton>

                        <RadioButton AutomationProperties.Name="Package manager" Style="{StaticResource NavItem}" GroupName="Nav" Tag="packages" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE7B8;" Margin="0,0,12,0"/><TextBlock Text="Package manager"/></StackPanel>
                        </RadioButton>
                        <TextBlock Text="INSIGHTS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource FaintTextBrush}" Margin="10,18,0,6"/>
                        <RadioButton AutomationProperties.Name="Live monitor" Style="{StaticResource NavItem}" GroupName="Nav" Tag="monitor" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;" Margin="0,0,12,0"/><TextBlock Text="Live monitor"/></StackPanel>
                        </RadioButton>
                        <RadioButton AutomationProperties.Name="Performance" Style="{StaticResource NavItem}" GroupName="Nav" Tag="performance" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xEC4A;" Margin="0,0,12,0"/><TextBlock Text="Performance"/></StackPanel>
                        </RadioButton>
                        <RadioButton AutomationProperties.Name="Install tracker" Style="{StaticResource NavItem}" GroupName="Nav" Tag="tracker" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8FD;" Margin="0,0,12,0"/><TextBlock Text="Install tracker"/></StackPanel>
                        </RadioButton>
                        <TextBlock Text="CLEAN UP" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource FaintTextBrush}" Margin="10,18,0,6"/>
                        <RadioButton AutomationProperties.Name="Junk files" Style="{StaticResource NavItem}" GroupName="Nav" Tag="junk" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" Margin="0,0,12,0"/><TextBlock Text="Junk files"/></StackPanel>
                        </RadioButton>
                        <RadioButton AutomationProperties.Name="Duplicates &amp; orphans" Style="{StaticResource NavItem}" GroupName="Nav" Tag="duplicates" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" Margin="0,0,12,0"/><TextBlock Text="Duplicates &amp; orphans"/></StackPanel>
                        </RadioButton>
                        <RadioButton AutomationProperties.Name="Browser history" Style="{StaticResource NavItem}" GroupName="Nav" Tag="browsers" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE774;" Margin="0,0,12,0"/><TextBlock Text="Browser history"/></StackPanel>
                        </RadioButton>
                        <RadioButton AutomationProperties.Name="Office history" Style="{StaticResource NavItem}" GroupName="Nav" Tag="office" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" Margin="0,0,12,0"/><TextBlock Text="Office history"/></StackPanel>
                        </RadioButton>
                        <RadioButton AutomationProperties.Name="Windows history" Style="{StaticResource NavItem}" GroupName="Nav" Tag="windows" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" Margin="0,0,12,0"/><TextBlock Text="Windows history"/></StackPanel>
                        </RadioButton>

                        <TextBlock Text="PRIVACY &amp; TOOLS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource FaintTextBrush}" Margin="10,18,0,6"/>
                        <RadioButton AutomationProperties.Name="Secure delete" Style="{StaticResource NavItem}" GroupName="Nav" Tag="shred" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" Margin="0,0,12,0"/><TextBlock Text="Secure delete"/></StackPanel>
                        </RadioButton>
                        <RadioButton AutomationProperties.Name="Wipe free space" Style="{StaticResource NavItem}" GroupName="Nav" Tag="wipe" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xEDA2;" Margin="0,0,12,0"/><TextBlock Text="Wipe free space"/></StackPanel>
                        </RadioButton>
                        <RadioButton AutomationProperties.Name="Windows tools" Style="{StaticResource NavItem}" GroupName="Nav" Tag="tools" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE90F;" Margin="0,0,12,0"/><TextBlock Text="Windows tools"/></StackPanel>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Content -->
        <DockPanel Grid.Column="1">
            <Border x:Name="AdminBanner" DockPanel.Dock="Top" Background="{DynamicResource WarningSoftBrush}" Padding="16,8" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Restart as administrator" Click="Elevate_Click" Padding="12,4" MinHeight="28"/>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xEA18;" Foreground="{DynamicResource WarningBrush}" Margin="0,0,10,0"/>
                    <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource TextBrush}"
                               Text="Standard rights: uninstalling works, but all-users leftovers, restore points and services need administrator rights."
                               TextTrimming="CharacterEllipsis" ToolTip="Uninstallers still run (Windows asks for permission when they need it). Removing leftovers under HKEY_LOCAL_MACHINE and Program Files, creating restore points and changing services need administrator rights."/>
                </DockPanel>
            </Border>
            <ContentControl x:Name="PageHost" Focusable="False"/>
        </DockPanel>
    </Grid>
</Window>
