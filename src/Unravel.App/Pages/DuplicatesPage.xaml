<UserControl x:Class="Unravel.App.Pages.DuplicatesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="24,20,24,16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Duplicates &amp; orphans" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0"
                       Text="Duplicates are matched by content (SHA-256), never by name. Orphans are folders nothing on this PC owns or uses, plus broken shortcuts. Removed items go to quarantine and can be restored."/>
        </StackPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="7" Padding="3" HorizontalAlignment="Left" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="TabDup" Style="{StaticResource Segment}" GroupName="DupTab" Content="Duplicate files" IsChecked="True" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabOrphan" Style="{StaticResource Segment}" GroupName="DupTab" Content="Orphaned files" Checked="Tab_Checked"/>
            </StackPanel>
        </Border>

        <!-- Duplicates -->
        <Grid x:Name="DupPanel">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <TextBlock Text="Smallest file" FontWeight="SemiBold" Margin="0,12,0,6"/>
                        <ComboBox x:Name="MinSize" SelectedIndex="1">
                            <ComboBoxItem Content="Any size" Tag="1"/>
                            <ComboBoxItem Content="100 KB" Tag="102400"/>
                            <ComboBoxItem Content="1 MB" Tag="1048576"/>
                            <ComboBoxItem Content="10 MB" Tag="10485760"/>
                            <ComboBoxItem Content="100 MB" Tag="104857600"/>
                        </ComboBox>
                        <TextBlock Text="File types" FontWeight="SemiBold" Margin="0,12,0,6"/>
                        <TextBox x:Name="Patterns" Text="*" Tag="e.g. *.jpg;*.mp4"/>
                        <Button x:Name="DupScan" Style="{StaticResource PrimaryButton}" Content="Find duplicates" Margin="0,14,0,0" Click="DupScan_Click"/>
                    </StackPanel>
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Add…" Style="{StaticResource GhostButton}" Padding="8,2" MinHeight="26" Click="AddFolder_Click"/>
                                <Button Content="Remove" Style="{StaticResource GhostButton}" Padding="8,2" MinHeight="26" Click="RemoveFolder_Click"/>
                            </StackPanel>
                            <TextBlock Text="Folders to scan" Style="{StaticResource SectionTitle}" Margin="0"/>
                        </DockPanel>
                        <ListBox x:Name="Folders" SelectionMode="Single"/>
                    </DockPanel>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0" Padding="0">
                <DockPanel>
                    <!-- Summary above the actions: side by side, a long summary squeezed the buttons into tall slabs. -->
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
                        <StackPanel>
                            <TextBlock x:Name="DupSummary" Foreground="{DynamicResource MutedTextBrush}" Text="Choose folders and press Find duplicates." TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <WrapPanel Orientation="Horizontal">
                                <TextBlock Text="Keep" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="KeepRule" Width="170" SelectedIndex="0" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <ComboBoxItem Content="newest copy"/>
                                    <ComboBoxItem Content="oldest copy"/>
                                    <ComboBoxItem Content="shortest path"/>
                                    <ComboBoxItem Content="copy in a chosen folder…"/>
                                </ComboBox>
                                <Button Content="Select others" Click="ApplyRule_Click" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <Button x:Name="DupDelete" Style="{StaticResource DangerButton}" Content="Remove checked…" Click="DupDelete_Click" IsEnabled="False" VerticalAlignment="Center"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Grid>
                        <DataGrid x:Name="DupGrid" Background="Transparent" IsReadOnly="False" SelectionMode="Extended" RowHeight="30">
                            <DataGrid.GroupStyle>
                                <GroupStyle>
                                    <!-- Without a rows presenter as the group panel, the DataGrid sizes every column to its minimum. -->
                                    <GroupStyle.Panel>
                                        <ItemsPanelTemplate><DataGridRowsPresenter/></ItemsPanelTemplate>
                                    </GroupStyle.Panel>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfaceAltBrush}" Padding="10,6" Margin="0,6,0,2" CornerRadius="5">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </DataGrid.GroupStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="44" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Click="DupCheck_Click" HorizontalAlignment="Center"/></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="File" Binding="{Binding Path}" Width="3*" IsReadOnly="True" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Size" Binding="{Binding Size, Converter={StaticResource Bytes}}" Width="90" IsReadOnly="True" ElementStyle="{StaticResource MutedCellText}"/>
                                <DataGridTextColumn Header="Modified" Binding="{Binding LastWrite, Converter={StaticResource Date}}" Width="100" IsReadOnly="True" ElementStyle="{StaticResource MutedCellText}"/>
                            </DataGrid.Columns>
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Open" Click="DupOpen_Click"/>
                                    <MenuItem Header="Open containing folder" Click="DupFolder_Click"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                        </DataGrid>
                        <Border x:Name="DupProgress" Background="{DynamicResource SurfaceBrush}" Visibility="Collapsed">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="460">
                                <TextBlock x:Name="DupPhase" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center"/>
                                <ProgressBar x:Name="DupBar" Margin="0,8" Maximum="100"/>
                                <TextBlock x:Name="DupDetail" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                                <Button Content="Cancel" HorizontalAlignment="Center" Margin="0,14,0,0" Click="Cancel_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Orphans -->
        <Border x:Name="OrphanPanel" Style="{StaticResource Card}" Padding="0" Visibility="Collapsed">
            <DockPanel>
                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="OrphanScan" Style="{StaticResource PrimaryButton}" Content="Find orphans" Click="OrphanScan_Click" Margin="0,0,8,0"/>
                            <Button x:Name="OrphanDelete" Style="{StaticResource DangerButton}" Content="Remove checked…" Click="OrphanDelete_Click" IsEnabled="False"/>
                        </StackPanel>
                        <TextBlock x:Name="OrphanSummary" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                                   Text="Looks in Program Files, ProgramData and AppData for folders no installed program, service, task, startup item, file association or running process uses, untouched for 30+ days. Nothing is pre-selected – check each item yourself."/>
                    </DockPanel>
                </Border>
                <Grid>
                    <DataGrid x:Name="OrphanGrid" Background="Transparent" IsReadOnly="False" SelectionMode="Extended" RowHeight="34">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="44" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Click="OrphanCheck_Click" HorizontalAlignment="Center"/></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Location" Binding="{Binding Path}" Width="3*" IsReadOnly="True" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Kind" Binding="{Binding KindText}" Width="110" IsReadOnly="True" ElementStyle="{StaticResource MutedCellText}"/>
                            <DataGridTemplateColumn Header="Confidence" Width="100" SortMemberPath="Safety.Confidence">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8" Padding="8,1" HorizontalAlignment="Left" ToolTip="{Binding Safety.Explanation}"
                                                Background="{Binding Safety.ConfidenceText, Converter={StaticResource ConfidenceBrush}, ConverterParameter=bg}">
                                            <TextBlock Text="{Binding Safety.ConfidenceText}" FontSize="12" Foreground="{Binding Safety.ConfidenceText, Converter={StaticResource ConfidenceBrush}}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Size" Binding="{Binding Size, Converter={StaticResource Bytes}}" SortMemberPath="Size" Width="90" IsReadOnly="True" ElementStyle="{StaticResource MutedCellText}"/>
                            <DataGridTextColumn Header="Last used" Binding="{Binding LastModified, Converter={StaticResource Date}}" Width="100" IsReadOnly="True" ElementStyle="{StaticResource MutedCellText}"/>
                            <DataGridTextColumn Header="Owner" Binding="{Binding Owner}" Width="1*" IsReadOnly="True" ElementStyle="{StaticResource MutedCellText}"/>
                        </DataGrid.Columns>
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding Evidence}" Margin="56,0,12,8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding StringFormat='• {0}'}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open" Click="OrphanOpen_Click"/>
                                <MenuItem Header="Open containing folder" Click="OrphanFolder_Click"/>
                                <MenuItem Header="Search online for the folder name" Click="OrphanSearch_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                    <Border x:Name="OrphanProgress" Background="{DynamicResource SurfaceBrush}" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="460">
                            <TextBlock Text="Looking for orphans…" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center"/>
                            <ProgressBar IsIndeterminate="True" Margin="0,8"/>
                            <TextBlock x:Name="OrphanDetail" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                            <Button Content="Cancel" HorizontalAlignment="Center" Margin="0,14,0,0" Click="Cancel_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
