<UserControl x:Class="Unravel.App.Pages.InstallTrackerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="24,20,24,16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Install tracker" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0"
                       Text="Record exactly what an installer changes – files, registry, services, scheduled tasks and startup entries – so it can be removed completely later. The uninstaller uses these logs automatically."/>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Record an installation" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Program name" Margin="0,4,0,6"/>
                        <TextBox x:Name="ProgramName" Tag="e.g. Contoso Editor 5"/>
                        <Button x:Name="BeginButton" Style="{StaticResource PrimaryButton}" Content="1. Take snapshot before installing" Margin="0,12,0,0" Click="Begin_Click"/>
                        <StackPanel x:Name="WaitingPanel" Visibility="Collapsed" Margin="0,12,0,0">
                            <TextBlock x:Name="WaitingText" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"/>
                            <Button x:Name="RunInstallerButton" Content="Run an installer and wait…" Margin="0,10,0,0" Click="RunInstaller_Click"/>
                            <Button x:Name="CompleteButton" Style="{StaticResource PrimaryButton}" Content="2. Finished installing – compare" Margin="0,8,0,0" Click="Complete_Click"/>
                        </StackPanel>
                        <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,12,0,0">
                            <ProgressBar IsIndeterminate="True"/>
                            <TextBlock x:Name="ProgressText" Margin="0,6,0,0" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedTextBrush}"/>
                            <Button Content="Cancel" HorizontalAlignment="Left" Margin="0,8,0,0" Click="Cancel_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="8">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="6,2,4,6">
                            <Button DockPanel.Dock="Right" Content="Delete log" Style="{StaticResource GhostButton}" Padding="8,2" MinHeight="26" Click="DeleteLog_Click"/>
                            <TextBlock Text="Recorded installs" Style="{StaticResource SectionTitle}" Margin="0"/>
                        </DockPanel>
                        <ListBox x:Name="Logs" SelectionChanged="Logs_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="6,4">
                                        <TextBlock Text="{Binding ProgramName}" FontWeight="SemiBold"/>
                                        <TextBlock FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}">
                                            <Run Text="{Binding Started, StringFormat=g, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding State, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </DockPanel>

            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,10">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="ExportButton" Content="Export…" Style="{StaticResource ToolButton}" Click="Export_Click"/>
                                    <Button x:Name="UndoButton" Content="Undo cleanup" Style="{StaticResource ToolButton}" Click="Undo_Click"/>
                                    <Button x:Name="CleanButton" Style="{StaticResource DangerButton}" Content="Remove what it added…" Click="Clean_Click" Margin="6,0,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="ResultTitle" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" Text="No install selected"/>
                            </DockPanel>
                            <WrapPanel x:Name="Chips" Margin="0,8,0,0"/>
                            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="7" Padding="3" HorizontalAlignment="Left" Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Area" Content="All" Tag="" IsChecked="True" Checked="Area_Checked"/>
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Area" Content="Files" Tag="File" Checked="Area_Checked"/>
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Area" Content="Registry" Tag="Registry" Checked="Area_Checked"/>
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Area" Content="Services" Tag="Service" Checked="Area_Checked"/>
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Area" Content="Tasks" Tag="ScheduledTask" Checked="Area_Checked"/>
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Area" Content="Startup" Tag="StartupEntry" Checked="Area_Checked"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    <DataGrid x:Name="ChangeGrid" Background="Transparent" RowHeight="30">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Change" Binding="{Binding Type}" Width="90" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="What" Binding="{Binding Area}" Width="110" ElementStyle="{StaticResource MutedCellText}"/>
                            <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="3*" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Details" Binding="{Binding Detail}" Width="1.4*" ElementStyle="{StaticResource MutedCellText}"/>
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open location" Click="OpenChange_Click"/>
                                <MenuItem Header="Copy location" Click="CopyChange_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
