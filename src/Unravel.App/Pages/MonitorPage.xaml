<UserControl x:Class="Unravel.App.Pages.MonitorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Unravel.App.Infrastructure">
    <UserControl.Resources>
        <Style x:Key="BigNumber" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="24,20,24,16">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="UpdatedText" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <ToggleButton x:Name="PauseButton" Content="Pause" MinWidth="80" Click="Pause_Click" AutomationProperties.Name="Pause updates"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Live monitor" Style="{StaticResource PageTitle}"/>
                <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0" Text="Real-time CPU, memory and disk activity, processes and services, with alerts for unusual behaviour. Updates every second while this page is open."/>
            </StackPanel>
        </DockPanel>

        <!-- Charts -->
        <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="0,0,0,12">
            <Border Style="{StaticResource Card}" Margin="0,0,6,0" Padding="14">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <TextBlock x:Name="CpuValue" DockPanel.Dock="Right" Style="{StaticResource BigNumber}" Text="–" Margin="10,0,0,0"/>
                        <StackPanel>
                            <TextBlock Text="CPU" FontWeight="SemiBold"/>
                            <TextBlock x:Name="CpuDetail" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </StackPanel>
                    </DockPanel>
                    <infra:Sparkline x:Name="CpuChart" Height="70" Margin="0,8,0,0" Stroke="{DynamicResource AccentBrush}"/>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6,0" Padding="14">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <TextBlock x:Name="MemValue" DockPanel.Dock="Right" Style="{StaticResource BigNumber}" Text="–" Margin="10,0,0,0"/>
                        <StackPanel>
                            <TextBlock Text="Memory" FontWeight="SemiBold"/>
                            <TextBlock x:Name="MemDetail" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </StackPanel>
                    </DockPanel>
                    <infra:Sparkline x:Name="MemChart" Height="70" Margin="0,8,0,0" Stroke="{DynamicResource SuccessBrush}"/>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6,0,0,0" Padding="14">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <TextBlock x:Name="DiskValue" DockPanel.Dock="Right" Style="{StaticResource BigNumber}" Text="–" Margin="10,0,0,0"/>
                        <StackPanel>
                            <TextBlock Text="Disk" FontWeight="SemiBold"/>
                            <TextBlock x:Name="DiskDetail" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </StackPanel>
                    </DockPanel>
                    <infra:Sparkline x:Name="DiskChart" Height="70" Margin="0,8,0,0" Stroke="{DynamicResource WarningBrush}" AutoScale="True"/>
                </DockPanel>
            </Border>
        </UniformGrid>

        <!-- Alerts -->
        <Border x:Name="AlertsCard" DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="AlertsTitle" Style="{StaticResource SectionTitle}"/>
                <ItemsControl x:Name="AlertList"/>
            </StackPanel>
        </Border>

        <!-- Tabs -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBox x:Name="FilterBox" DockPanel.Dock="Right" Width="260" Tag="Filter by name or path" TextChanged="Filter_Changed"/>
            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="7" Padding="3" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabProcesses" Style="{StaticResource Segment}" GroupName="MonTab" Content="Processes" IsChecked="True" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabServices" Style="{StaticResource Segment}" GroupName="MonTab" Content="Services" Checked="Tab_Checked"/>
                </StackPanel>
            </Border>
        </DockPanel>

        <Border Style="{StaticResource Card}" Padding="0">
            <Grid>
                <DataGrid x:Name="ProcessGrid" Background="Transparent" SelectionMode="Single" RowHeight="32">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.5*" MinWidth="160" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70" ElementStyle="{StaticResource MutedCellText}"/>
                        <DataGridTextColumn Header="CPU" Binding="{Binding CpuText}" SortMemberPath="Cpu" Width="80" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Memory" Binding="{Binding MemoryText}" SortMemberPath="Memory" Width="100" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Disk / I/O" Binding="{Binding IoText}" SortMemberPath="Io" Width="100" ElementStyle="{StaticResource MutedCellText}"/>
                        <DataGridTextColumn Header="Threads" Binding="{Binding Threads}" Width="80" ElementStyle="{StaticResource MutedCellText}"/>
                        <DataGridTextColumn Header="Handles" Binding="{Binding Handles}" Width="80" ElementStyle="{StaticResource MutedCellText}"/>
                        <DataGridTextColumn Header="Location" Binding="{Binding Path}" Width="2*" ElementStyle="{StaticResource MutedCellText}"/>
                    </DataGrid.Columns>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="End process…" Click="EndProcess_Click"/>
                            <MenuItem Header="End process tree…" Click="EndTree_Click"/>
                            <Separator/>
                            <MenuItem Header="Open file location" Click="OpenLocation_Click"/>
                            <MenuItem Header="Search online" Click="Search_Click"/>
                            <MenuItem Header="Properties" Click="Properties_Click"/>
                            <MenuItem Header="Check signature" Click="Signature_Click"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>
                <DockPanel x:Name="ServicesPanel" Visibility="Collapsed">
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource ToolButton}" Content="Start" Click="StartService_Click"/>
                            <Button Style="{StaticResource ToolButton}" Content="Stop" Click="StopService_Click"/>
                            <Button Style="{StaticResource ToolButton}" Content="Refresh" Click="RefreshServices_Click"/>
                            <CheckBox x:Name="RunningOnly" Content="Running only" Margin="12,0,0,0" VerticalAlignment="Center" Click="Filter_Changed"/>
                        </StackPanel>
                    </Border>
                    <DataGrid x:Name="ServiceGrid" Background="Transparent" SelectionMode="Single" RowHeight="32">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Service" Binding="{Binding DisplayName}" Width="1.6*" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1*" ElementStyle="{StaticResource MutedCellText}"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Start type" Binding="{Binding StartType}" Width="100" ElementStyle="{StaticResource MutedCellText}"/>
                            <DataGridCheckBoxColumn Header="Core" Binding="{Binding IsCritical}" Width="60" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Program" Binding="{Binding ImagePath}" Width="2*" ElementStyle="{StaticResource MutedCellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
