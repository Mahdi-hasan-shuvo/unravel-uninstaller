<UserControl x:Class="Unravel.App.Pages.ProgramsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ContextMenu x:Key="RowMenu" Opened="RowMenu_Opened">
            <MenuItem x:Name="MiUninstall" Header="Uninstall…" Click="Uninstall_Click" FontWeight="SemiBold">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="13"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem x:Name="MiForced" Header="Forced MSI uninstall…" Click="ForcedMsi_Click"/>
            <MenuItem x:Name="MiModify" Header="Change" Click="Modify_Click">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" FontSize="13"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem x:Name="MiRepair" Header="Repair" Click="Repair_Click">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE90F;" FontSize="13"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Search on Google for">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13"/></MenuItem.Icon>
                <MenuItem x:Name="MiSearchName" Header="Program name" Click="SearchName_Click"/>
                <MenuItem x:Name="MiSearchPublisher" Header="Publisher" Click="SearchPublisher_Click"/>
            </MenuItem>
            <MenuItem x:Name="MiAbout" Header="Open about link" Click="AboutLink_Click"/>
            <MenuItem x:Name="MiHelp" Header="Open help link" Click="HelpLink_Click"/>
            <MenuItem x:Name="MiUpdate" Header="Open update link" Click="UpdateLink_Click"/>
            <Separator/>
            <MenuItem x:Name="MiLocation" Header="Open install location" Click="Location_Click">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="13"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Open registry key" Click="Registry_Click">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE943;" FontSize="13"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Copy name" Click="CopyName_Click">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="13"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Remove entry from list…" Click="RemoveEntry_Click"/>
            <MenuItem Header="Export list">
                <MenuItem Header="As HTML…" Click="ExportHtml_Click"/>
                <MenuItem Header="As text…" Click="ExportText_Click"/>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>

    <DockPanel Margin="24,20,24,16">
        <!-- Header -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox x:Name="SearchBy" Width="130" SelectedIndex="0" SelectionChanged="Search_Changed" ToolTip="Search by">
                    <ComboBoxItem Content="Name"/>
                    <ComboBoxItem Content="Publisher"/>
                    <ComboBoxItem Content="Any field"/>
                </ComboBox>
                <TextBox x:Name="SearchBox" Width="280" Margin="8,0,0,0" Tag="Search programs  (Ctrl+F)" TextChanged="Search_Changed"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Programs" Style="{StaticResource PageTitle}"/>
                <TextBlock x:Name="CountText" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="6" Margin="0,0,0,12">
            <DockPanel>
                <Border DockPanel.Dock="Right" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="7" Padding="3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ViewDetails" Style="{StaticResource Segment}" GroupName="View" Content="Details" Checked="View_Checked"/>
                        <RadioButton x:Name="ViewTiles" Style="{StaticResource Segment}" GroupName="View" Content="Tiles" Checked="View_Checked"/>
                        <RadioButton x:Name="ViewList" Style="{StaticResource Segment}" GroupName="View" Content="List" Checked="View_Checked"/>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="UninstallButton" AutomationProperties.Name="Uninstall" Style="{StaticResource PrimaryButton}" Click="Uninstall_Click" Margin="0,0,8,0" ToolTip="Uninstall the selected program and scan for leftovers (Del)">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="Uninstall"/></StackPanel>
                    </Button>
                    <Button x:Name="ModifyButton" AutomationProperties.Name="Change" Style="{StaticResource ToolButton}" Click="Modify_Click" ToolTip="Change the installed features (only when the installer supports it)">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" FontSize="14" Margin="0,0,6,0"/><TextBlock Text="Change"/></StackPanel>
                    </Button>
                    <Button x:Name="RepairButton" AutomationProperties.Name="Repair" Style="{StaticResource ToolButton}" Click="Repair_Click" ToolTip="Repair the installation (Windows Installer programs)">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE90F;" FontSize="14" Margin="0,0,6,0"/><TextBlock Text="Repair"/></StackPanel>
                    </Button>
                    <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="6,6"/>
                    <Button AutomationProperties.Name="Refresh" Style="{StaticResource ToolButton}" Click="Refresh_Click" ToolTip="Reload the list from the registry (F5)">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="14" Margin="0,0,6,0"/><TextBlock Text="Refresh"/></StackPanel>
                    </Button>
                    <Button x:Name="ExportButton" AutomationProperties.Name="Export" Style="{StaticResource ToolButton}" Click="ExportMenu_Click" ToolTip="Export the visible list">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xEDE1;" FontSize="14" Margin="0,0,6,0"/><TextBlock Text="Export"/></StackPanel>
                    </Button>
                    <Button x:Name="ColumnsButton" AutomationProperties.Name="Columns" Style="{StaticResource ToolButton}" Click="Columns_Click" ToolTip="Choose columns">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE71C;" FontSize="14" Margin="0,0,6,0"/><TextBlock Text="Columns"/></StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="DetailsColumn" Width="320"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <DataGrid x:Name="ProgramGrid" Background="Transparent" SelectionMode="Single" MouseDoubleClick="Grid_DoubleClick"
                              SelectionChanged="Selection_Changed" ContextMenu="{StaticResource RowMenu}" Sorting="Grid_Sorting">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Name" Width="2.6*" MinWidth="230" SortMemberPath="Name" CanUserSort="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" ToolTip="{Binding Tooltip}">
                                            <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource CellText}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="0.8*" MinWidth="90" ElementStyle="{StaticResource MutedCellText}"/>
                            <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="1.3*" MinWidth="90" ElementStyle="{StaticResource MutedCellText}"/>
                            <DataGridTextColumn Header="Installed" Binding="{Binding InstallDate, Converter={StaticResource Date}}" SortMemberPath="InstallDate" Width="0.8*" MinWidth="90" ElementStyle="{StaticResource MutedCellText}"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding Size, Converter={StaticResource Bytes}}" SortMemberPath="Size" Width="0.7*" MinWidth="90" ElementStyle="{StaticResource MutedCellText}"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="0.8*" MinWidth="90" ElementStyle="{StaticResource MutedCellText}"/>
                            <DataGridTextColumn Header="Installer" Binding="{Binding Installer}" Width="1*" MinWidth="90" ElementStyle="{StaticResource MutedCellText}"/>
                            <DataGridTextColumn Header="Website" Binding="{Binding Website}" Width="1*" MinWidth="90" ElementStyle="{StaticResource MutedCellText}"/>
                            <DataGridTextColumn Header="Comment" Binding="{Binding Comment}" Width="1*" MinWidth="90" ElementStyle="{StaticResource MutedCellText}"/>
                            <DataGridTextColumn Header="Install location" Binding="{Binding Location}" Width="1.2*" MinWidth="90" ElementStyle="{StaticResource MutedCellText}"/>
                            <DataGridTextColumn Header="Uninstall command" Binding="{Binding UninstallString}" Width="1.2*" MinWidth="90" ElementStyle="{StaticResource MutedCellText}"/>
                            <DataGridTextColumn Header="Registry key" Binding="{Binding RegistryKey}" Width="1.2*" MinWidth="90" ElementStyle="{StaticResource MutedCellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <ListBox x:Name="Tiles" Visibility="Collapsed" Padding="8" SelectionChanged="Selection_Changed" MouseDoubleClick="Grid_DoubleClick"
                             ContextMenu="{StaticResource RowMenu}" VirtualizingPanel.IsVirtualizing="False">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="112" Margin="4,8" ToolTip="{Binding Tooltip}">
                                    <Image Source="{Binding Icon}" Width="40" Height="40" Margin="0,0,0,8" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="{Binding Name}" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" FontSize="12"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ListBox x:Name="ListView" Visibility="Collapsed" Padding="8" SelectionChanged="Selection_Changed" MouseDoubleClick="Grid_DoubleClick"
                             ContextMenu="{StaticResource RowMenu}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4,3" ToolTip="{Binding Tooltip}">
                                    <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding Name}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel x:Name="EmptyState" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="32" Foreground="{DynamicResource FaintTextBrush}"/>
                        <TextBlock x:Name="EmptyText" Text="No programs match your search." Margin="0,10,0,0" Foreground="{DynamicResource MutedTextBrush}"/>
                    </StackPanel>
                    <StackPanel x:Name="LoadingState" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="180"/>
                        <TextBlock Text="Reading installed programs…" Margin="0,10,0,0" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Details pane -->
            <Border x:Name="DetailsPane" Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0">
                <Grid>
                    <TextBlock x:Name="NoSelection" Text="Select a program to see its details." Style="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <Image x:Name="DetailIcon" Width="48" Height="48" HorizontalAlignment="Left" Margin="0,0,0,12" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock x:Name="DetailName" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="DetailPublisher" Style="{StaticResource Muted}" Margin="0,2,0,14"/>
                            <Grid x:Name="DetailFacts">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                            </Grid>
                            <StackPanel x:Name="DetailLinks" Margin="0,14,0,0"/>
                            <Button x:Name="DetailUninstall" Style="{StaticResource PrimaryButton}" Content="Uninstall…" Margin="0,18,0,0" HorizontalAlignment="Stretch" Click="Uninstall_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
