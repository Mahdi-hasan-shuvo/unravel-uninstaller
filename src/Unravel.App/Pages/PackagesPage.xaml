<UserControl x:Class="Unravel.App.Pages.PackagesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="24,20,24,16">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource ToolButton}" Click="Export_Click" AutomationProperties.Name="Export list">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xEDE1;" FontSize="14" Margin="0,0,6,0"/><TextBlock Text="Export list"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="Import_Click" AutomationProperties.Name="Reinstall from list">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="14" Margin="0,0,6,0"/><TextBlock Text="Reinstall from list…"/></StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Package manager" Style="{StaticResource PageTitle}"/>
                <TextBlock x:Name="VersionText" Style="{StaticResource Muted}" Margin="0,2,0,0" Text="Install, update, uninstall and move programs with WinGet, the Windows Package Manager."/>
            </StackPanel>
        </DockPanel>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="7" Padding="3" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabInstalled" Style="{StaticResource Segment}" GroupName="PkgTab" Content="Installed" IsChecked="True" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabUpdates" Style="{StaticResource Segment}" GroupName="PkgTab" Content="Updates" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabSearch" Style="{StaticResource Segment}" GroupName="PkgTab" Content="Find &amp; install" Checked="Tab_Checked"/>
                </StackPanel>
            </Border>
        </DockPanel>

        <!-- Output console -->
        <Border x:Name="ConsoleCard" DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="12,8" Margin="0,12,0,0" Visibility="Collapsed">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancel" Click="Cancel_Click" MinHeight="26" Padding="10,2"/>
                    <Button DockPanel.Dock="Right" Content="Hide" Style="{StaticResource GhostButton}" Click="HideConsole_Click" MinHeight="26" Padding="10,2"/>
                    <StackPanel Orientation="Horizontal">
                        <ProgressBar x:Name="Busy" IsIndeterminate="True" Width="80" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ConsoleTitle" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
                <TextBox x:Name="ConsoleText" IsReadOnly="True" Height="120" Margin="0,8,0,0" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                         VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
            </DockPanel>
        </Border>

        <!-- Toolbar per tab -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="6" Margin="0,0,0,10">
            <Grid>
                <DockPanel x:Name="InstalledBar">
                    <TextBox x:Name="FilterBox" DockPanel.Dock="Right" Width="200" Tag="Filter" TextChanged="Filter_Changed" VerticalAlignment="Top"/>
                    <WrapPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ToolButton}" Content="Update" Click="Update_Click"/>
                        <Button Style="{StaticResource ToolButton}" Content="Uninstall…" Click="Uninstall_Click" ToolTip="Uninstall with WinGet and scan for leftovers"/>
                        <Button Style="{StaticResource ToolButton}" Content="Reinstall…" Click="Reinstall_Click"/>
                        <Button Style="{StaticResource ToolButton}" Content="Details" Click="Details_Click"/>
                        <Button Style="{StaticResource ToolButton}" Content="Refresh" Click="Refresh_Click"/>
                        <CheckBox x:Name="HideLocal" Content="Only packages WinGet can manage" Margin="12,0,0,0" VerticalAlignment="Center" Click="Filter_Changed"
                                  ToolTip="Hide programs WinGet only knows from Programs and Features (they can't be updated through WinGet)"/>
                    </WrapPanel>
                </DockPanel>
                <StackPanel x:Name="UpdatesBar" Orientation="Horizontal" Visibility="Collapsed">
                    <Button Style="{StaticResource PrimaryButton}" Content="Update selected" Click="Update_Click" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource ToolButton}" Content="Update all…" Click="UpdateAll_Click"/>
                    <Button Style="{StaticResource ToolButton}" Content="Check again" Click="Refresh_Click"/>
                </StackPanel>
                <DockPanel x:Name="SearchBar" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ComboBox x:Name="ScopeBox" Width="150" SelectedIndex="0" Margin="0,0,8,0" ToolTip="Install for">
                            <ComboBoxItem Content="Default scope"/>
                            <ComboBoxItem Content="Only me"/>
                            <ComboBoxItem Content="All users"/>
                        </ComboBox>
                        <Button Style="{StaticResource PrimaryButton}" Content="Install" Click="Install_Click" MinWidth="90"/>
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Content="Search" Click="Search_Click" Margin="8,0" MinWidth="80" IsDefault="True"/>
                    <TextBox x:Name="SearchBox" Tag="Name or package ID, e.g. 7zip or Mozilla.Firefox"/>
                </DockPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}" Padding="0">
            <Grid>
                <DataGrid x:Name="Grid" Background="Transparent" SelectionMode="Extended" MouseDoubleClick="Grid_DoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" MinWidth="200" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Package ID" Binding="{Binding Id}" Width="2*" ElementStyle="{StaticResource MutedCellText}"/>
                        <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="1*" ElementStyle="{StaticResource MutedCellText}"/>
                        <DataGridTextColumn Header="Available" Binding="{Binding Available}" Width="1*" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="90" ElementStyle="{StaticResource MutedCellText}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel x:Name="Empty" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="EmptyText" Foreground="{DynamicResource MutedTextBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"/>
                </StackPanel>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
