<UserControl x:Class="Unravel.App.Pages.StartupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="24,20,24,16">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBox x:Name="SearchBox" DockPanel.Dock="Right" Width="280" VerticalAlignment="Center" Tag="Search startup items" TextChanged="Search_Changed"/>
            <StackPanel>
                <TextBlock Text="Startup manager" Style="{StaticResource PageTitle}"/>
                <TextBlock x:Name="CountText" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="6" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="ShowServices" Content="Services" IsChecked="True" Margin="0,0,16,0" Click="Filter_Click"/>
                    <CheckBox x:Name="ShowMicrosoft" Content="Microsoft services" Margin="0,0,8,0" Click="ShowMicrosoft_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button AutomationProperties.Name="Add" Style="{StaticResource PrimaryButton}" Click="Add_Click" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="Add"/></StackPanel>
                    </Button>
                    <Button x:Name="RunButton" AutomationProperties.Name="Run" Style="{StaticResource ToolButton}" Click="Run_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="14" Margin="0,0,6,0"/><TextBlock Text="Run"/></StackPanel>
                    </Button>
                    <Button x:Name="KillButton" AutomationProperties.Name="End process" Style="{StaticResource ToolButton}" Click="Kill_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE71A;" FontSize="14" Margin="0,0,6,0"/><TextBlock Text="End process"/></StackPanel>
                    </Button>
                    <Button x:Name="RemoveButton" AutomationProperties.Name="Remove" Style="{StaticResource ToolButton}" Click="Remove_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="14" Margin="0,0,6,0"/><TextBlock Text="Remove"/></StackPanel>
                    </Button>
                    <Button AutomationProperties.Name="Refresh" Style="{StaticResource ToolButton}" Click="Refresh_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="14" Margin="0,0,6,0"/><TextBlock Text="Refresh"/></StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Style="{StaticResource Card}" Padding="0">
            <Grid>
                <DataGrid x:Name="Grid" Background="Transparent" SelectionMode="Single" IsReadOnly="False" SelectionChanged="Grid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="On" Width="56" SortMemberPath="Enabled">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox Style="{StaticResource Switch}" Margin="0" IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="Start automatically with Windows"
                                              AutomationProperties.Name="{Binding Name, StringFormat='Start {0} with Windows'}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Name" Width="1.6*" MinWidth="180" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding Icon}" Width="18" Height="18" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource CellText}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Status" Width="0.8*" MinWidth="112" SortMemberPath="StatusText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="9" Padding="8,2" HorizontalAlignment="Left" Background="{Binding StatusBackground}">
                                        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{Binding StatusForeground}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="1.1*" IsReadOnly="True" ElementStyle="{StaticResource MutedCellText}"/>
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="1.2*" IsReadOnly="True" ElementStyle="{StaticResource MutedCellText}"/>
                        <DataGridTextColumn Header="Launch command" Binding="{Binding Command}" Width="2*" IsReadOnly="True" ElementStyle="{StaticResource MutedCellText}"/>
                        <DataGridTextColumn Header="Starts from" Binding="{Binding Source}" Width="0.9*" IsReadOnly="True" ElementStyle="{StaticResource MutedCellText}"/>
                        <DataGridTextColumn Header="For" Binding="{Binding Scope}" Width="0.8*" IsReadOnly="True" ElementStyle="{StaticResource MutedCellText}"/>
                    </DataGrid.Columns>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Run process" Click="Run_Click"/>
                            <MenuItem Header="End process" Click="Kill_Click"/>
                            <Separator/>
                            <MenuItem Header="Search on Google for">
                                <MenuItem Header="Startup name" Click="SearchName_Click"/>
                                <MenuItem Header="File name" Click="SearchFile_Click"/>
                                <MenuItem Header="Publisher" Click="SearchPublisher_Click"/>
                                <MenuItem Header="Description" Click="SearchDescription_Click"/>
                            </MenuItem>
                            <MenuItem Header="Open containing folder" Click="Folder_Click"/>
                            <MenuItem Header="Go to startup location" Click="Location_Click"/>
                            <MenuItem Header="Open program's uninstall registry key" Click="UninstallKey_Click"/>
                            <MenuItem Header="Copy launch command" Click="Copy_Click"/>
                            <MenuItem Header="Properties" Click="Properties_Click"/>
                            <Separator/>
                            <MenuItem Header="Remove selected…" Click="Remove_Click"/>
                            <MenuItem Header="Remove all invalid…" Click="RemoveInvalid_Click"/>
                            <MenuItem Header="Remove all not running…" Click="RemoveNotRunning_Click"/>
                            <MenuItem Header="Remove all disabled…" Click="RemoveDisabled_Click"/>
                            <Separator/>
                            <MenuItem Header="Open Windows Services" Click="Services_Click"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>
                <StackPanel x:Name="LoadingState" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="180"/>
                    <TextBlock Text="Reading startup items…" Margin="0,10,0,0" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
