<UserControl x:Class="Unravel.App.Pages.WindowsAppsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="24,20,24,16">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBox x:Name="SearchBox" DockPanel.Dock="Right" Width="300" VerticalAlignment="Center" Tag="Search apps" TextChanged="Search_Changed"/>
            <StackPanel>
                <TextBlock Text="Windows apps" Style="{StaticResource PageTitle}"/>
                <TextBlock x:Name="CountText" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="6" Margin="0,0,0,12">
            <DockPanel>
                <CheckBox x:Name="ShowSystem" DockPanel.Dock="Right" Content="Show frameworks and system apps" VerticalAlignment="Center" Margin="0,0,8,0" Click="ShowSystem_Click"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="UninstallButton" AutomationProperties.Name="Uninstall" Style="{StaticResource PrimaryButton}" Click="Uninstall_Click" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="Uninstall"/></StackPanel>
                    </Button>
                    <Button x:Name="RunButton" AutomationProperties.Name="Run" Style="{StaticResource ToolButton}" Click="Run_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="14" Margin="0,0,6,0"/><TextBlock Text="Run"/></StackPanel>
                    </Button>
                    <Button AutomationProperties.Name="Refresh" Style="{StaticResource ToolButton}" Click="Refresh_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="14" Margin="0,0,6,0"/><TextBlock Text="Refresh"/></StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Style="{StaticResource Card}" Padding="0">
            <Grid>
                <DataGrid x:Name="Grid" Background="Transparent" SelectionMode="Single" SelectionChanged="Grid_SelectionChanged" MouseDoubleClick="Grid_DoubleClick">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Name" Width="2.2*" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="24" Height="24" CornerRadius="4" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,10,0">
                                            <Image Source="{Binding Icon}" Width="20" Height="20"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource CellText}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Size" Binding="{Binding Size, Converter={StaticResource Bytes}}" SortMemberPath="Size" Width="0.7*" ElementStyle="{StaticResource MutedCellText}"/>
                        <DataGridTextColumn Header="Installed" Binding="{Binding InstallDate, Converter={StaticResource Date}}" SortMemberPath="InstallDate" Width="0.8*" ElementStyle="{StaticResource MutedCellText}"/>
                        <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="0.9*" ElementStyle="{StaticResource MutedCellText}"/>
                        <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="1.3*" ElementStyle="{StaticResource MutedCellText}"/>
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="1.5*" ElementStyle="{StaticResource MutedCellText}"/>
                    </DataGrid.Columns>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Uninstall…" Click="Uninstall_Click" FontWeight="SemiBold"/>
                            <MenuItem Header="Run" Click="Run_Click"/>
                            <Separator/>
                            <MenuItem Header="Search on Google for">
                                <MenuItem Header="App name" Click="SearchName_Click"/>
                                <MenuItem Header="Publisher" Click="SearchPublisher_Click"/>
                            </MenuItem>
                            <MenuItem Header="Open install location" Click="Location_Click"/>
                            <MenuItem Header="Open in Microsoft Store" Click="Store_Click"/>
                            <MenuItem Header="Open registry key" Click="Registry_Click"/>
                            <MenuItem Header="Copy package name" Click="CopyPackage_Click"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>
                <StackPanel x:Name="LoadingState" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="180"/>
                    <TextBlock Text="Reading Windows apps…" Margin="0,10,0,0" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
